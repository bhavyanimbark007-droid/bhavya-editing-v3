# Neon / PostgreSQL connection string
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/bhavya_cms

# Used to sign admin session cookies (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Admin password. On FIRST run you may leave this empty and set the
# password from /admin (it gets bcrypt-hashed and stored in site_settings).
# If set here, it takes precedence. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpass', 10))"
ADMIN_PASSWORD_HASH=

# Cloudinary (used by /api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
